# TigerGraph MCP connection (tigergraph-mcp --env-file fraud_agent/mcp.env)
# Copy to mcp.env (gitignored) and fill in — never commit the real file.
#
# Generate TG_API_TOKEN from the GSQL secret (valid 30 days; regenerate when it
# expires):
#   .venv/bin/python -c "import requests,json; \
#     e=dict(l.strip().split('=',1) for l in open('fraud_agent/.env') if '=' in l); \
#     print(requests.post(e['TIGERGRAPH_HOST'].rstrip('/')+'/auth/token', \
#       json={'secret':e['TIGERGRAPH_SECRET'],'lifetime':2592000}).json()['token'])"
TG_HOST=https://YOUR-INSTANCE.tgcloud.io
TG_GRAPHNAME=Fraud
TG_TGCLOUD=true
TG_SECRET=your-gsql-secret
TG_API_TOKEN=your-restpp-bearer-token
