CREATE VERTEX Account(id STRING PRIMARY KEY, customer_id STRING, opened_at DATETIME)
CREATE VERTEX Txn(id STRING PRIMARY KEY, amount DOUBLE, ts DATETIME, channel STRING, risk_score DOUBLE)
CREATE VERTEX Device(id STRING PRIMARY KEY)
CREATE VERTEX Case(id STRING PRIMARY KEY, status STRING, risk DOUBLE, decision STRING)
CREATE UNDIRECTED EDGE MadeTxn(FROM Account, TO Txn)
CREATE UNDIRECTED EDGE UsedDevice(FROM Account, TO Device)
CREATE UNDIRECTED EDGE LinkedCase(FROM Case, TO Account, evidence STRING, created_at DATETIME)
