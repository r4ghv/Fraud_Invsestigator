CREATE GRAPH Fraud()
CREATE VERTEX Customer(id STRING PRIMARY KEY, risk_note STRING)
CREATE VERTEX Card(id STRING PRIMARY KEY, customer_id STRING)
CREATE VERTEX Txn(id STRING PRIMARY KEY, amt DOUBLE, ts DATETIME, channel STRING, product STRING, region STRING, risk DOUBLE)
CREATE VERTEX DeviceProfile(id STRING PRIMARY KEY, info STRING, os STRING, browser STRING, screen STRING)
CREATE VERTEX EmailDomain(id STRING PRIMARY KEY)
CREATE VERTEX BillingRegion(id STRING PRIMARY KEY)
CREATE VERTEX ClosedCase(id STRING PRIMARY KEY, outcome STRING, pattern STRING, exposure DOUBLE, notes STRING)
CREATE VERTEX Case(id STRING PRIMARY KEY, status STRING, verdict STRING, prob DOUBLE, pattern STRING)
CREATE UNDIRECTED EDGE OWNS (FROM Customer, TO Card)
CREATE DIRECTED EDGE MADE (FROM Card, TO Txn)
CREATE DIRECTED EDGE FROM_DEVICE (FROM Txn, TO DeviceProfile)
CREATE DIRECTED EDGE BILLED_IN (FROM Txn, TO BillingRegion)
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Txn)
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card)
CREATE DIRECTED EDGE CASE_ON (FROM Case, TO Card)
