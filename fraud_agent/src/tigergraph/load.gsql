CREATE LOADING JOB load_fraud FOR GRAPH Fraud {
  DEFINE FILENAME txn_file;
  DEFINE FILENAME ident_file;
  DEFINE FILENAME cc_file;

  LOAD txn_file TO VERTEX Customer VALUES ($0, "") USING header="false", separator=",";
  LOAD txn_file TO VERTEX Card VALUES ($16, $16) USING header="false", separator=",";
  LOAD txn_file TO VERTEX Txn VALUES ($0, $2, $17, $18, $3, $10, $19)
    USING header="false", separator=",";
  LOAD txn_file TO VERTEX BillingRegion VALUES ($10) USING header="false", separator=",";
  LOAD txn_file TO EDGE OWNS VALUES ($16, $16) USING header="false", separator=",";
  LOAD txn_file TO EDGE MADE VALUES ($16, $0) USING header="false", separator=",";
  LOAD txn_file TO EDGE BILLED_IN VALUES ($0, $10) USING header="false", separator=",";

  LOAD ident_file TO VERTEX DeviceProfile VALUES ($40, $40, $30, $31, $33)
    USING header="false", separator=",";
  LOAD ident_file TO EDGE FROM_DEVICE VALUES ($0, $40) USING header="false", separator=",";

  LOAD cc_file TO VERTEX ClosedCase VALUES ($0, $5, $6, $10, $14)
    USING header="false", separator=",";
  LOAD cc_file TO VERTEX Card VALUES ($3, $2) USING header="false", separator=",";
  LOAD cc_file TO VERTEX Customer VALUES ($2, "") USING header="false", separator=",";
  LOAD cc_file TO EDGE OWNS VALUES ($2, $3) USING header="false", separator=",";
  LOAD cc_file TO EDGE ON_CARD VALUES ($0, $3) USING header="false", separator=",";
}
