# Face ID + Blockchain Verification Configuration

# -------------------------------------------------------------
# Blockchain Provider Configuration
# -------------------------------------------------------------
# Options:
# 1. Local Anvil / Hardhat (Default if running on 127.0.0.1:8545)
#    RPC_URL=http://127.0.0.1:8545
#
# 2. Public Testnet (Base Sepolia)
#    RPC_URL=https://sepolia.base.org
#    PRIVATE_KEY=your_private_key_here_with_testnet_eth
#
# 3. Public Testnet (Ethereum Sepolia)
#    RPC_URL=https://rpc.sepolia.org
#    PRIVATE_KEY=your_private_key_here
#
# 4. Embedded PyEVM (Zero configuration: leave RPC_URL empty)
RPC_URL=

# Submitting account private key (required for public testnets; auto-configured for local/tester)
PRIVATE_KEY=

# Pre-deployed FaceVerificationRegistry contract address (leave empty to auto-deploy)
CONTRACT_ADDRESS=

# -------------------------------------------------------------
# Reverse Search Configuration
# -------------------------------------------------------------
CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
SEARCH_TIMEOUT_SECONDS=45

# Face detection confidence threshold (0.0 to 1.0)
FACE_DETECTION_THRESHOLD=0.5
